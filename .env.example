# =======================================================
# NatlusLab: Environment Configuration Example
# =======================================================
# Salin berkas ini menjadi .env di server Anda:
# cp .env.example .env

# Konfigurasi Basis Data PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=natluslab_db
DB_USER=natluslab_user
DB_PASSWORD=password_kuat_anda

# Konfigurasi Aplikasi & Server
PORT=5000
NODE_ENV=production
VITE_APP_NAME=NatlusLab
